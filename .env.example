# --- App ---
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Brand ---
BRAND_NAME=ScribeKare
# Registered company name (invoices, terms, privacy). Change after incorporation.
COMPANY_LEGAL_NAME=ScribeKare

# --- Database ---
DATABASE_URL=sqlite:///./medscribe.db
# For PostgreSQL (production): postgresql://user:password@host:port/dbname

# --- Sarvam ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Groq (LLM structuring) ---
GROQ_API_KEY=your_groq_api_key_here



# --- WhatsApp messages list (Fernet key; REQUIRED in production) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_MESSAGES_KEY=

# --- Production readiness (all optional; defaults shown) ---
HEALTH_DB_TIMEOUT_SECONDS=3
BOOT_LOCK_TIMEOUT_SECONDS=600
WS_PING_INTERVAL_SECONDS=20
SCHEDULER_LEADER_RETRY_SECONDS=30
# Optional rotation list, comma-separated, newest first. The single key above is still read.
WHATSAPP_MESSAGES_KEYS=

# --- Key separation (optional; unset = old behaviour + a startup warning) ---
# Same Fernet generator as above. Comma-separated lists are newest first.
TOTP_ENC_KEY=
QR_HASH_KEY=
DATA_ENC_KEYS=

# --- Boot behaviour (defaults shown = today's behaviour) ---
RUN_MIGRATIONS_ON_BOOT=true
RUNTIME_SCHEMA_SYNC=true
SCHEDULER_ENABLED=true
SEED_TUTORIAL_ON_BOOT=true
MASTER_CATALOG_AUTOLOAD_ON_BOOT=true
DAY_END_CATCHUP_ON_BOOT=true

# --- Database ---
DB_REQUIRE_SSL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# --- Requests and rate limits ---
MAX_BODY_BYTES=12582912
DEFAULT_RATE_LIMIT=600/minute
REDIS_URL=

# --- Monitoring and logging ---
SENTRY_DSN=
LOG_LEVEL=INFO
LOGIN_FAILURE_ALERT_THRESHOLD=20
LOGIN_FAILURE_ALERT_WINDOW_SECONDS=300

# --- Consent notice version (replace when legal text is approved) ---
CONSENT_NOTICE_VERSION=v0-PENDING-LEGAL-REVIEW

# --- Retention (0 = off, nothing deleted) ---
RAW_TRANSCRIPT_RETENTION_DAYS=0
CHAT_UPLOAD_RETENTION_DAYS=0
WHATSAPP_MESSAGE_RETENTION_DAYS=180

# --- Optional AWS Secrets Manager id (empty = off) ---
AWS_SECRETS_ID=

# --- Patient portal session (minutes) ---
PORTAL_ACCESS_TOKEN_EXPIRE_MINUTES=240
PORTAL_SESSION_MAX_MINUTES=720